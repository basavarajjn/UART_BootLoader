

#include<stm32xx.h>




void UART_GPIO_Init(void)
{
	RCC->AHB1ENR |= (1 << 0);
	RCC->APB1ENR |= (1 << 17);

	GPIOA->MODER &= ~(3 << 4);
	GPIOA->MODER &= ~(3 << 6);
	GPIOA->MODER |= (2 << 4);
	GPIOA->MODER |= (2 << 6);

	GPIOA->AFR[0] &= ~(0x0F << 8);
	GPIOA->AFR[0] &= ~(0x0F << 12);

	GPIOA->AFR[0] |= (7 << 8);
	GPIOA->AFR[0] |= (7 << 12);

}


void UART_Init(void)
{
    USART2->CR1	= 0;
    USART2->BRR = 0x008B;
    USART2->CR1 |= (1 << 2);
    USART2->CR1 |= (1 << 3);
    USART2->CR1 |= (1 << 13);
}


void UART_Transmit_Char(uint8_t data)
{
	while(!(USART2->SR & (1 << 7)));
	USART2->DR = data;
}


void UART_Transmit_String(const char *str)
{
	while(*str != '\0')
	{
		UART_Transmit_Char(*str);
		str++;
	}
}


uint8_t UART_Receive_Data(void)
{
	uint8_t data=0;
    while(!(USART2->SR & (1 << 5)));
     data = USART2->DR;
}
